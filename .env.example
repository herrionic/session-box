# SessionBox configuration.
#
# - docker compose reads this file automatically for variable substitution
#   (SESSIONBOX_MASTER_KEY is required there).
# - For local `pnpm dev` runs, set the variables in your shell instead.
#   Copy to `.env` and load with: node --env-file=.env ... (optional).

# HTTP listen address
SESSIONBOX_HOST=0.0.0.0
SESSIONBOX_PORT=8787

# Container runtime. Only "docker" is implemented for the MVP.
SESSIONBOX_RUNTIME=docker

# Docker Engine connection (inside the published image: /var/run/docker.sock)
SESSIONBOX_DOCKER_SOCKET=/var/run/docker.sock

# Shared Docker network connecting the server and all containers.
# Container SSH is never published to the host; reachability is via this network.
SESSIONBOX_DOCKER_NETWORK=sessionbox

# Container base image (built from images/base/Dockerfile)
SESSIONBOX_BASE_IMAGE=sessionbox/base:latest

# Persisted state directory
SESSIONBOX_DATA_DIR=./data

# SQLite database file (defaults to <data dir>/sessionbox.db)
# SESSIONBOX_DATABASE_FILE=./data/sessionbox.db

# Plugin / API clients: JSON array. Empty means the API is unauthenticated
# (development default; a warning is logged at startup).
# SESSIONBOX_CLIENTS=[{"id":"dsh","token":"change-me","permissions":["*"]}]

# How often lifecycle policy (auto-stop) is evaluated, in milliseconds
# SESSIONBOX_LIFECYCLE_INTERVAL_MS=15000

# Server master key for credential encryption (required from Day 2 on).
# Generate with: openssl rand -base64 32
# SESSIONBOX_MASTER_KEY=

SESSIONBOX_LOG_LEVEL=info

# Optional: serve the built web UI from this directory
# SESSIONBOX_WEB_DIST=./apps/web/dist
